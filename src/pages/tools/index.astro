---
import PageHeader from "@components/common/PageHeader.astro";
import ToolsSection from "@components/parts/Tools.svelte";
import BaseLayout from "../../layouts/Layout.astro";
import { t } from "../../lib/i18n/strings";

const locale = "en-gb";
---
<BaseLayout
  locale={locale}
  title={t(locale, "toolsHeading")}
  description={t(locale, "toolsSubheading")}
>
  <PageHeader
    locale={locale}
    title={t(locale, "toolsHeading")}
    subtitle={t(locale, "toolsSubheading")}
  />

  <main class="max-w-5xl mx-auto px-4 mt-8">
    <ToolsSection />
  </main>
</BaseLayout>
