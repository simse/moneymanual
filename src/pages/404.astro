---
import BaseLayout from "../layouts/Layout.astro";
import { copy } from "../lib/copy";
---
<BaseLayout title={copy.notFoundTitle} description={copy.notFoundBody}>
  <main class="max-w-3xl mx-auto px-4 py-16">
    <p class="text-zinc-500 font-bold text-lg mb-2">404</p>
    <h1 class="text-4xl font-bold mb-4">{copy.notFoundHeading}</h1>
    <p class="text-lg mb-6">{copy.notFoundBody}</p>
    <a href={"/"} class="text-teal-700 hover:text-teal-900 underline font-bold">{copy.notFoundHomeLink}</a>
  </main>
</BaseLayout>
