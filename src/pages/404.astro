---
import BaseLayout from "../layouts/Layout.astro";
import { t } from "../lib/i18n/strings";
import { localeFromPathname, localePath } from "../lib/i18n/urls";

const locale = localeFromPathname(Astro.url.pathname);
---
<BaseLayout locale={locale} title={t(locale, "notFoundTitle")} description={t(locale, "notFoundBody")}>
  <main class="max-w-3xl mx-auto px-4 py-16">
    <p class="text-zinc-500 font-bold text-lg mb-2">404</p>
    <h1 class="text-4xl font-bold mb-4">{t(locale, "notFoundHeading")}</h1>
    <p class="text-lg mb-6">{t(locale, "notFoundBody")}</p>
    <a href={localePath(locale)} class="text-teal-700 hover:text-teal-900 underline font-bold">{t(locale, "notFoundHomeLink")}</a>
  </main>
</BaseLayout>
