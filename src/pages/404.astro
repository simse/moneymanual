---
import BaseLayout from "../layouts/Layout.astro";
---
<BaseLayout title="404" description="We couldn't find the page you were looking for.">
  <main class="max-w-3xl mx-auto px-4 py-16">
    <p class="text-zinc-500 font-bold text-lg mb-2">404</p>
    <h1 class="text-4xl font-bold mb-4">Page not found</h1>
    <p class="text-lg mb-6">We couldn't find the page you were looking for.</p>
    <a href={"/"} class="text-teal-700 hover:text-teal-900 underline font-bold">Back to home</a>
  </main>
</BaseLayout>
