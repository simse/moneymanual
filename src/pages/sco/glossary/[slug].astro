---
import GlossaryTermPage from "@components/page/GlossaryTermPage.astro";
import { glossaryTermBySlug } from "../../../lib/content";

const { slug } = Astro.params;
const entry = slug ? await glossaryTermBySlug("sco", slug) : undefined;

if (!entry) {
	return Astro.rewrite("/404");
}
---
<GlossaryTermPage locale="sco" entry={entry} />
