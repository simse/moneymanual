---
import ArticlePage from "@components/page/ArticlePage.astro";
import { getPageEntry, pageEntries } from "../lib/content";

export const prerender = true;

export const getStaticPaths = async () => {
    const allPages = await pageEntries();

    return allPages.map((page) => ({ params: { slug: page.id } }));
};

const { slug } = Astro.params;
const page = await getPageEntry(slug);

if (!page) {
    return Astro.rewrite("/404");
}
---

<ArticlePage page={page} />
