---
import {
	childEntriesForSection,
	type PageEntry,
	parseEntryId,
	urlPathForEntry,
} from "../lib/content";
import { copy } from "../lib/copy";

interface Props {
	page: PageEntry;
}

const { page } = Astro.props;
const parsed = parseEntryId(page.id);
const topic = parsed?.topic ?? "";

const sectionPages = await childEntriesForSection(topic);
---
<header class="bg-teal-900 text-white">
  <div class="max-w-5xl mx-auto px-4 pt-4 pb-14 border-t-8 border-teal-700">
    <a href={"/"} class="underline text-lg font-medium mb-8 block">{copy.home}</a>

    <h1 class="text-4xl font-bold mb-4">{page.data.title}</h1>

    <p class="text-white/90 text-xl max-w-xl font-medium">{page.data.description}</p>
  </div>
</header>

<main class="max-w-5xl mx-auto p-4">
  <h2 class="my-6 text-2xl font-medium">{copy.topics}</h2>

  <ul>
    {sectionPages.map(entry => (
    <li class="border-t border-zinc-400 group">
      <a href={urlPathForEntry(entry)} class="py-6 block">
        <h3 class="text-xl font-bold mb-2 underline text-teal-600 group-hover:text-teal-800 group-active:bg-yellow-400 group-active:text-black w-fit">
          {entry.data.title}
        </h3>
        <p class="text-lg max-w-2xl">{entry.data.description}</p>
      </a>
    </li>
    ))}
  </ul>
</main>
