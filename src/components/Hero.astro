---
import { copy } from "../lib/copy";
import Search from "./Search.svelte";
---
<header class="text-white bg-teal-900 w-full py-12">
  <div class="max-w-5xl mx-auto px-4">
    <h1 class="text-3xl font-bold max-w-3xl mb-6">{copy.heroHeading}</h1>

    <p class="text-xl">{copy.heroSubheading}</p>

    <div class="mt-8 pt-8 border-t border-white/50">
        <p class="text-lg font-bold mb-2">{copy.findATopic}</p>
      <Search client:load/>
    </div>
  </div>
</header>
