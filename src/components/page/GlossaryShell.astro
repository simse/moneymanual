---
import Breadcrumbs from "@components/Breadcrumbs.svelte";
import GlossaryTermList from "@components/glossary/GlossaryTermList.svelte";
import type { GlossaryTermEntry } from "../../lib/content";
import { glossaryTermSlug } from "../../lib/content";
import { copy } from "../../lib/copy";
import type { TopicId } from "../../lib/glossary-topics";

interface Props {
	terms: GlossaryTermEntry[];
	selectedSlug?: string;
	breadcrumbTerm?: string;
}

const { terms, selectedSlug, breadcrumbTerm } = Astro.props;

const summaries = terms.map((entry) => {
	const slug = glossaryTermSlug(entry);

	return {
		slug,
		term: entry.data.term,
		short: entry.data.short,
		topic: entry.data.topic as TopicId,
		href: `/glossary/${slug}`,
	};
});

const glossaryHref = "/glossary";
const homeHref = "/";

const breadcrumbs: { text: string; href?: string }[] = [
	{ text: copy.home, href: homeHref },
	{ text: copy.glossaryBreadcrumb, href: glossaryHref },
];

if (breadcrumbTerm) {
	breadcrumbs.push({
		text: breadcrumbTerm,
	});
}
---

<header
    class="max-w-5xl mx-auto px-4 pt-4 pb-2 border-t-8 border-teal-700 flex items-baseline gap-4"
>
    <Breadcrumbs links={breadcrumbs} />
    <span class="ml-auto text-sm text-zinc-500 font-medium">
        {copy.glossaryTermCount(terms.length)}
    </span>
</header>

<main
    class="max-w-5xl mx-auto px-4 py-8 grid grid-cols-1 md:grid-cols-12 gap-8"
>
    <aside class="md:col-span-4">
        <GlossaryTermList
            client:load
            terms={summaries}
            selectedSlug={selectedSlug}
            filterPlaceholder={copy.glossaryFilterPlaceholder}
        />
    </aside>

    <div class="md:col-span-8">
        <slot />
    </div>
</main>
