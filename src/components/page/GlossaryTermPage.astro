---
import { render } from "astro:content";
import GlossaryShell from "@components/page/GlossaryShell.astro";
import Layout from "../../layouts/Layout.astro";
import type { GlossaryTermEntry } from "../../lib/content";
import {
	glossaryTermSlug,
	glossaryTerms,
	relatedGlossaryTerms,
} from "../../lib/content";
import { copy } from "../../lib/copy";
import { iconFor } from "../../lib/glossary-icons";
import { topicById } from "../../lib/glossary-topics";

interface Props {
	entry: GlossaryTermEntry;
}

const { entry } = Astro.props;

const allTerms = await glossaryTerms();
const related = relatedGlossaryTerms(allTerms, entry, 3);
const topic = topicById(entry.data.topic);
const { Content } = await render(entry);
const slug = glossaryTermSlug(entry);
---

<Layout
    title={entry.data.term}
    description={`${entry.data.term} — ${copy.glossaryDescription}`}
>
    <GlossaryShell
        terms={allTerms}
        selectedSlug={slug}
        breadcrumbTerm={entry.data.term}
    >
        <article>
            <span
                class={`inline-flex items-center gap-1.5 mb-3 px-2 py-1 text-xs font-bold uppercase ${topic.tone.soft} ${topic.tone.fg}`}
            >
                <span class={`w-1.5 h-1.5 rounded-full ${topic.tone.dot}`}
                ></span>
                {topic.name}
            </span>
            <h1 class="text-4xl font-bold mb-2">{entry.data.term}</h1>
            {
                entry.data.name && (
                    <p class="text-xl text-zinc-500 font-medium mb-6">
                        {entry.data.name}
                    </p>
                )
            }
            {
                entry.data.short && !entry.data.name && (
                    <p class="text-xl text-zinc-500 font-medium mb-6">
                        ({entry.data.short})
                    </p>
                )
            }

            <div
                class="prose prose-zinc max-w-none prose-p:text-zinc-900 prose-p:font-medium prose-p:text-lg prose-p:leading-relaxed mb-16"
            >
                <Content />
            </div>

            {
                entry.data.prominentLinks &&
                    entry.data.prominentLinks.length > 0 && (
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                            {entry.data.prominentLinks.map((link) => {
                                const icon = iconFor(link.icon);
                                return (
                                    <a
                                        href={link.href}
                                        class="group flex gap-3 bg-white p-3 border border-zinc-200 hover:border-teal-700"
                                    >
                                        <div
                                            class={`w-10 h-10 shrink-0 flex items-center justify-center ${icon.bg}`}
                                        >
                                            <icon.Icon
                                                class={`h-5 w-5 ${icon.fg}`}
                                            />
                                        </div>
                                        <div>
                                            <p class="font-bold text-zinc-900 group-hover:text-teal-800 group-hover:underline text-sm leading-tight">
                                                {link.title}
                                            </p>
                                            <p class="text-zinc-600 text-xs mt-1">
                                                {link.description}
                                            </p>
                                        </div>
                                    </a>
                                );
                            })}
                        </div>
                    )
            }

            {
                related.length > 0 && (
                    <>
                        <h2 class="font-bold uppercase text-xs tracking-widest text-zinc-500 mb-3">
                            {copy.glossarySeeAlso}
                        </h2>
                        <ul class="grid grid-cols-1 md:grid-cols-3 gap-3">
                            {related.map((r) => {
                                const rSlug = glossaryTermSlug(r);
                                return (
                                    <li>
                                        <a
										href={`/glossary/${rSlug}`}
                                            class="block border border-zinc-200 p-3 hover:border-teal-700 hover:bg-zinc-50 h-full"
                                        >
                                            <p class="font-bold text-zinc-900">
                                                {r.data.term}
                                            </p>
                                            {r.data.name && (
                                                <p class="text-zinc-600 text-sm mt-1">
                                                    {r.data.name}
                                                </p>
                                            )}
                                        </a>
                                    </li>
                                );
                            })}
                        </ul>
                    </>
                )
            }
        </article>
    </GlossaryShell>
</Layout>
