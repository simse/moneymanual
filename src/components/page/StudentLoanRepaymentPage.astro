---
import PageHeader from "@components/common/PageHeader.astro";
import Calculator from "@components/tools/student-loan-repayment/Calculator.svelte";
import Layout from "../../layouts/Layout.astro";
import { studentLoanRepaymentStateSchema } from "../../lib/calculator-state-schemas";
import { DEFAULT_LOCALE, type Locale } from "../../lib/i18n/locales";
import { t } from "../../lib/i18n/strings";
import { localePath } from "../../lib/i18n/urls";

interface Props {
	locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

const title = t(locale, "toolsStudentLoanPageTitle");
const description = t(locale, "toolsStudentLoanPageDescription");

const raw = await Astro.session?.get("student-loan-repayment");
const initial = studentLoanRepaymentStateSchema.safeParse(raw).data ?? null;
---
<Layout
  locale={locale}
  title={title}
  description={description}
>
  <PageHeader
    locale={locale}
    title={title}
    subtitle={description}
    breadcrumbs={[
      {
        text: t(locale, "tools"),
        href: localePath(locale, "tools"),
      }
    ]}
  />

  <main class="max-w-5xl mx-auto px-4 my-8">
    <Calculator locale={locale} initial={initial} client:load />
  </main>
</Layout>
