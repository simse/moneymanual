---
import PageHeader from "@components/common/PageHeader.astro";
import Calculator from "@components/tools/student-loan-repayment/Calculator.svelte";
import Layout from "../../layouts/Layout.astro";

const title = "Student Loan Repayment Calculator";
const description = "Find out how long it will take to repay your UK student loan, how much you will pay back in total, and whether your loan will be written off, based on your salary, plan and graduation year.";
---
<Layout
  title={title}
  description={description}
>
  <PageHeader
    title={title}
    subtitle={description}
    breadcrumbs={[
      {
        text: "Tools",
        href: "/tools",
      }
    ]}
  />

  <main class="max-w-5xl mx-auto px-4 my-8">
    <Calculator client:load />
  </main>
</Layout>
