---
import Hero from "@components/Hero.astro";
import Tools from "@components/parts/Tools.svelte";
import Layout from "../../layouts/Layout.astro";
import { sectionEntries, urlPathForEntry } from "../../lib/content";
import { copy } from "../../lib/copy";

const sections = await sectionEntries();
---
<Layout
  description={copy.homepageDescription}
>
  <Hero />

  <main class="max-w-5xl mx-auto px-4 mt-8">
    <section class="mt-8 mb-12">
      <h2 class="text-2xl font-bold my-4">{copy.tools}</h2>

      <Tools />
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-bold my-4">{copy.topics}</h2>

      <ul class="md:w-4/5">
        {sections.map(entry => (
        <li class="border-t">
          <a class="group py-4 block" href={urlPathForEntry(entry)}>
            <h3 class="text-xl font-bold text-teal-700 group-hover:text-teal-900 underline mb-2">{entry.data.title}</h3>
            <p class="text-lg font-medium">{entry.data.description}</p>
          </a>
        </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>
