---
import PageHeader from "@components/common/PageHeader.astro";
import Calculator from "@components/tools/take-home-calculator/Calculator.svelte";
import Layout from "../../layouts/Layout.astro";
import { takeHomePayStateSchema } from "../../lib/calculator-state-schemas";
import { copy } from "../../lib/copy";

const title = copy.toolsTakeHomePageTitle;
const description = copy.toolsTakeHomePageDescription;

const raw = await Astro.session?.get("take-home-pay");
const initial = takeHomePayStateSchema.safeParse(raw).data ?? null;
---
<Layout
  title={title}
  description={description}
>
  <PageHeader
    title={title}
    subtitle={description}
    breadcrumbs={[
      {
        text: copy.tools,
        href: "/tools",
      }
    ]}
  />

  <main class="max-w-5xl mx-auto px-4 my-8">
    <Calculator initial={initial} client:load />
  </main>
</Layout>
