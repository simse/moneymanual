---
import "../styles/global.css";
import Footer from "@components/Footer.svelte";
import Navbar from "@components/Navbar.svelte";
import { sectionEntriesForLocale, urlPathForEntry } from "../lib/content";
import { DEFAULT_LOCALE, htmlLangFor, type Locale } from "../lib/i18n/locales";
import { t } from "../lib/i18n/strings";
import { alternateUrlFor, localePath } from "../lib/i18n/urls";

interface Props {
	locale?: Locale;
	title?: string;
	description: string;
}

const { locale = DEFAULT_LOCALE, title, description } = Astro.props;

const sections = await sectionEntriesForLocale(locale);
const topics = sections.map((entry) => ({
	title: entry.data.title,
	href: urlPathForEntry(entry),
	description: entry.data.description,
}));

const currentPath = Astro.url.pathname;
const enHref = new URL(alternateUrlFor(currentPath, "en-gb"), Astro.site).href;
const cyHref = new URL(alternateUrlFor(currentPath, "cy"), Astro.site).href;
const pageTitle = title
	? `${title}${t(locale, "titleSuffix")}`
	: t(locale, "siteTagline");
---
<!doctype html>
<html lang={htmlLangFor(locale)} class="scroll-pt-4">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="en-GB" href={enHref} />
    <link rel="alternate" hreflang="cy" href={cyHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="bg-white text-zinc-950 min-h-svh flex flex-col">
    <Navbar locale={locale} homeHref={localePath(locale)} topics={topics} client:load />

    <div class="flex-1">
      <slot />
    </div>

    <Footer locale={locale} currentPath={currentPath} topics={topics.map(t => ({ title: t.title, href: t.href }))} />
  </body>
</html>
