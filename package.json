{
  "name": "money-website",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "search:sync": "node scripts/search-sync.ts",
    "dev": "astro dev",
    "build": "astro build",
    "deploy:staging": "CLOUDFLARE_ENV=staging astro build && wrangler deploy --env staging",
    "deploy:prod": "CLOUDFLARE_ENV=prod astro build && wrangler deploy --env prod",
    "astro": "astro",
    "test": "vitest run",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.0",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/svelte": "9.0.1",
    "@saving-tool/hmrc-income-tax": "3.0.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.1",
    "astro-favicons": "3.1.6",
    "lodash": "4.18.1",
    "minisearch": "7.2.0",
    "sitemap": "9.0.1",
    "svelte": "5.57.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@iconify/json": "2.2.471",
    "@oxlint/plugins": "1.81.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.19",
    "@types/lodash": "4.17.24",
    "@types/node": "25.6.2",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unplugin-icons": "23.0.1",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0",
    "yaml": "2.8.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.3"
}
